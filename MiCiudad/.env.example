# Copiar a .env y completar. No subir .env a git.
# Solo hace falta para APK / development build. Expo Go no la usa.
GOOGLE_MAPS_KEY=

# API local. No uses localhost en el teléfono.
#   Emulador Android: http://10.0.2.2:3000
#   Teléfono (misma wifi): http://<IP-de-la-PC>:3000
EXPO_PUBLIC_URL_API=http://10.0.2.2:3000
